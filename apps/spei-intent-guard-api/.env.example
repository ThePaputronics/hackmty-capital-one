# Environment Configuration
# Copy this file to .env and update the values

# Application
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Allowed web origin for CORS (unset or empty = allow any origin)
CORS_ORIGIN=http://localhost:3001

# Local Docker database
DATABASE_URL=postgresql+psycopg://spei:spei@localhost:5433/spei_intent_guard
