# Environment Configuration
# Copy this file to .env and update the values

# Application
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Allowed browser origins for CORS, comma-separated.
# Unset or empty falls back to http://localhost:3000,http://localhost:3001.
# A wildcard is never used: this API answers credentialed requests.
CORS_ORIGIN=http://localhost:3001

# Local Docker database
DATABASE_URL=postgresql+psycopg://spei:spei@localhost:5433/spei_intent_guard
